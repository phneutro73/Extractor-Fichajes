{
  "manifest_version": 3,
  "name": "Extractor de Fichajes",
  "version": "1.1.0",
  "description": "Extrae los fichajes (Entrada/Salida) desde la página de presencia y muestra las horas totales, presenciales y de teletrabajo.",
  "author": "Roberto Peralta",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*/puntos_detalle_trabajador*",
        "http://*/puntos_detalle_trabajador*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Extractor de Fichajes"
  }
}